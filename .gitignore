# Ignore all . folders but include files
.*/
# Allow .config and .local/bin folders
!.config/
!.local/bin/
# Allow .files inside them (maybe redundant?)
!.config/**
!.local/bin/**
# Allow Claude Code config files (not sessions/cache)
!.claude/
!.claude/settings.json
!.claude/statusline-command.sh
# Allow root-level gitconfig
!.gitconfig
# Generic junk
*.swp
*~
.DS_Store
